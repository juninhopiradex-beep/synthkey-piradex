<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="1">
    <title>SYNTHKEY by Piradex</title>
    <welcome file="welcome.txt" mime-type="text/plain"/>
    <options customize="allow" require-scripts="false" hostArchitectures="x86_64,arm64"/>
    <allowed-os-versions>
        <os-version min="10.13"/>
    </allowed-os-versions>
    <domains enable_localSystem="true"/>
    <choices-outline>
        <line choice="com.piradex.synthkey.plugins"/>
        <line choice="com.piradex.synthkey.packs"/>
    </choices-outline>
    <choice id="com.piradex.synthkey.plugins" title="Plugin SYNTHKEY (VST3 + Audio Unit + Standalone)"
            description="O sintetizador. Obrigatório." enabled="false" selected="true">
        <pkg-ref id="com.piradex.synthkey.plugins"/>
    </choice>
    <choice id="com.piradex.synthkey.packs" title="Packs de samples (Trap, R&amp;B, Afrobeats, Amapiano, Drill, Kizomba, Kuduro)"
            description="Bibliotecas por estilo. Ficam bloqueadas até inserir a chave de cada pack. Pode instalá-las mais tarde." start_selected="true">
        <pkg-ref id="com.piradex.synthkey.packs"/>
    </choice>
    <pkg-ref id="com.piradex.synthkey.plugins" version="@VERSAO@" onConclusion="none">synthkey-plugins.pkg</pkg-ref>
    <pkg-ref id="com.piradex.synthkey.packs" version="@VERSAO@" onConclusion="none">synthkey-packs.pkg</pkg-ref>
</installer-gui-script>
